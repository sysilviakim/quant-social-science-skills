# Normalize line endings: LF in the repository, native in the working tree.
* text=auto

# Always LF, since these are executed or parsed by tools that dislike CRLF.
*.sh    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Always CRLF: PowerShell on older hosts is happier with it.
*.ps1   text eol=crlf

# Never touch these.
*.png   binary
*.jpg   binary
*.pdf   binary
